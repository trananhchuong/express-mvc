<% if (totalPages > 1) { %>
<% const _qs = (typeof qs !== 'undefined' && qs) ? qs + '&' : ''; %>
<nav class="mt-3">
    <ul class="pagination pagination-sm justify-content-end mb-0">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="<%= baseUrl %>?<%= _qs %>page=<%= page - 1 %>">Previous</a>
        </li>
        <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
            <a class="page-link" href="<%= baseUrl %>?<%= _qs %>page=<%= i %>"><%= i %></a>
        </li>
        <% } %>
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="<%= baseUrl %>?<%= _qs %>page=<%= page + 1 %>">Next</a>
        </li>
    </ul>
</nav>
<% } %>
