<%- include('../partials/head', { title: title }) %>
    <body class="sb-nav-fixed">
        <%- include('../partials/topnav') %>
        <div id="layoutSidenav">
            <div id="layoutSidenav_nav">
                <%- include('../partials/sidebar') %>
            </div>
            <div id="layoutSidenav_content">
                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Orders</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active">Orders</li>
                        </ol>
                        <div class="card mb-4">
                            <div class="card-header"><i class="fas fa-shopping-cart me-1"></i> Order List</div>
                            <div class="card-body">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Customer</th>
                                            <th>Username</th>
                                            <th>Total Price</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% orders.forEach(order => { %>
                                        <tr>
                                            <td><%= order.id %></td>
                                            <td><%= order.user.fullName %></td>
                                            <td><%= order.user.username %></td>
                                            <td>$<%= Number(order.totalPrice).toLocaleString() %></td>
                                            <td>
                                                <a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-info text-white">View</a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                        <% if (orders.length === 0) { %>
                                        <tr><td colspan="5" class="text-center text-muted">No orders found.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                                <%- include('../partials/pagination', { page, totalPages, baseUrl: '/admin/orders' }) %>
                            </div>
                        </div>
                    </div>
                </main>
                <%- include('../partials/footer') %>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/scripts.js"></script>
    </body>
</html>
