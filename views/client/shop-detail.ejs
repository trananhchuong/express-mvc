<%- include('./partials/head', { title: title }) %>

<%- include('./partials/navbar') %>

<!-- Page Header -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Shop Detail</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
        <li class="breadcrumb-item active text-white"><%= product.name %></li>
    </ol>
</div>

<!-- Product Detail Start -->
<div class="container-fluid py-5 mt-5">
    <div class="container py-5">
        <div class="row g-4 mb-5">
            <!-- Main content -->
            <div class="col-lg-8 col-xl-9">
                <div class="row g-4">
                    <!-- Product image -->
                    <div class="col-lg-6">
                        <div class="border rounded">
                            <% if (product.image) { %>
                            <img src="<%= product.image %>" class="img-fluid rounded w-100" alt="<%= product.name %>" style="max-height:400px;object-fit:contain;">
                            <% } else { %>
                            <div class="d-flex align-items-center justify-content-center bg-light rounded" style="height:400px;">
                                <i class="fas fa-laptop fa-6x text-secondary"></i>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Product info -->
                    <div class="col-lg-6">
                        <h4 class="fw-bold mb-3"><%= product.name %></h4>
                        <p class="mb-3">Category: <span class="badge bg-secondary"><%= product.target %></span></p>
                        <p class="mb-3">Brand: <strong><%= product.factory %></strong></p>
                        <h5 class="fw-bold mb-3 text-primary">$<%= Number(product.price).toLocaleString() %></h5>
                        <div class="d-flex mb-4">
                            <i class="fa fa-star text-secondary"></i>
                            <i class="fa fa-star text-secondary"></i>
                            <i class="fa fa-star text-secondary"></i>
                            <i class="fa fa-star text-secondary"></i>
                            <i class="fa fa-star"></i>
                        </div>
                        <p class="mb-4"><%= product.shortDesc %></p>
                        <div class="d-flex mb-3">
                            <span class="me-3"><i class="fas fa-cubes me-1 text-primary"></i> Stock: <strong><%= product.quantity %></strong></span>
                            <span><i class="fas fa-check-circle me-1 text-success"></i> Sold: <strong><%= product.sold %></strong></span>
                        </div>

                        <!-- Quantity selector (UI only — cart is Chapter 11) -->
                        <div class="input-group quantity mb-4" style="width: 110px;">
                            <div class="input-group-btn">
                                <button class="btn btn-sm btn-minus rounded-circle bg-light border">
                                    <i class="fa fa-minus"></i>
                                </button>
                            </div>
                            <input type="text" class="form-control form-control-sm text-center border-0" value="1">
                            <div class="input-group-btn">
                                <button class="btn btn-sm btn-plus rounded-circle bg-light border">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <a href="#" class="btn border border-secondary rounded-pill px-4 py-2 mb-4 text-primary">
                            <i class="fa fa-shopping-bag me-2 text-primary"></i> Add to cart
                        </a>
                    </div>

                    <!-- Description tabs -->
                    <div class="col-lg-12">
                        <nav>
                            <div class="nav nav-tabs mb-3">
                                <button class="nav-link active border-white border-bottom-0" type="button" data-bs-toggle="tab" data-bs-target="#nav-description">Description</button>
                                <button class="nav-link border-white border-bottom-0" type="button" data-bs-toggle="tab" data-bs-target="#nav-reviews">Reviews</button>
                            </div>
                        </nav>
                        <div class="tab-content mb-5">
                            <div class="tab-pane active" id="nav-description">
                                <p><%= product.detailDesc %></p>
                                <div class="px-2">
                                    <div class="row g-4">
                                        <div class="col-6">
                                            <div class="row bg-light align-items-center text-center justify-content-center py-2">
                                                <div class="col-6"><p class="mb-0">Brand</p></div>
                                                <div class="col-6"><p class="mb-0"><%= product.factory %></p></div>
                                            </div>
                                            <div class="row text-center align-items-center justify-content-center py-2">
                                                <div class="col-6"><p class="mb-0">Category</p></div>
                                                <div class="col-6"><p class="mb-0"><%= product.target %></p></div>
                                            </div>
                                            <div class="row bg-light text-center align-items-center justify-content-center py-2">
                                                <div class="col-6"><p class="mb-0">Price</p></div>
                                                <div class="col-6"><p class="mb-0">$<%= Number(product.price).toLocaleString() %></p></div>
                                            </div>
                                            <div class="row text-center align-items-center justify-content-center py-2">
                                                <div class="col-6"><p class="mb-0">Stock</p></div>
                                                <div class="col-6"><p class="mb-0"><%= product.quantity %></p></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane" id="nav-reviews">
                                <p class="text-muted fst-italic">No reviews yet. Be the first!</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4 col-xl-3">
                <div class="mb-4">
                    <form method="GET" action="/shop" class="input-group">
                        <input type="search" name="search" class="form-control p-2" placeholder="Search...">
                        <button class="input-group-text" type="submit"><i class="fa fa-search"></i></button>
                    </form>
                </div>
                <% if (related.length > 0) { %>
                <h5 class="mb-3">Related Products</h5>
                <% related.forEach(r => { %>
                <div class="d-flex align-items-center mb-3 border-bottom pb-3">
                    <div class="me-3 flex-shrink-0" style="width:70px;height:70px;">
                        <% if (r.image) { %>
                        <img src="<%= r.image %>" class="img-fluid rounded w-100 h-100" alt="<%= r.name %>" style="object-fit:cover;">
                        <% } else { %>
                        <div class="bg-light d-flex align-items-center justify-content-center rounded w-100 h-100">
                            <i class="fas fa-laptop text-secondary"></i>
                        </div>
                        <% } %>
                    </div>
                    <div>
                        <h6 class="mb-1"><a href="/shop/<%= r.id %>" class="text-dark text-decoration-none"><%= r.name %></a></h6>
                        <p class="mb-0 text-primary fw-bold">$<%= Number(r.price).toLocaleString() %></p>
                    </div>
                </div>
                <% }) %>
                <% } %>
            </div>
        </div>

        <!-- Related Products Grid -->
        <% if (related.length > 0) { %>
        <h3 class="fw-bold mb-4">Related Products</h3>
        <div class="row g-4">
            <% related.forEach(r => { %>
            <div class="col-md-6 col-lg-3">
                <div class="rounded position-relative fruite-item">
                    <div class="fruite-img">
                        <% if (r.image) { %>
                        <img src="<%= r.image %>" class="img-fluid w-100 rounded-top" alt="<%= r.name %>" style="height:160px;object-fit:cover;">
                        <% } else { %>
                        <div class="bg-light d-flex align-items-center justify-content-center rounded-top" style="height:160px;">
                            <i class="fas fa-laptop fa-3x text-secondary"></i>
                        </div>
                        <% } %>
                    </div>
                    <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top:10px;left:10px;"><%= r.target %></div>
                    <div class="p-3 border border-secondary border-top-0 rounded-bottom">
                        <h6 class="text-truncate"><%= r.name %></h6>
                        <div class="d-flex justify-content-between align-items-center">
                            <p class="text-dark fw-bold mb-0">$<%= Number(r.price).toLocaleString() %></p>
                            <a href="/shop/<%= r.id %>" class="btn btn-sm border border-secondary rounded-pill text-primary">View</a>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>

        <div class="mt-4">
            <a href="/shop" class="btn btn-primary rounded-pill px-4"><i class="fa fa-arrow-left me-2"></i> Back to Shop</a>
        </div>
    </div>
</div>
<!-- Product Detail End -->

<%- include('./partials/footer') %>
