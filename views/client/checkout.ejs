<%- include('./partials/head', { title: title }) %>

<%- include('./partials/navbar') %>

<!-- Page Header -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Checkout</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/cart">Cart</a></li>
        <li class="breadcrumb-item active text-white">Checkout</li>
    </ol>
</div>

<!-- Checkout Start -->
<div class="container-fluid py-5">
    <div class="container py-5">
        <form method="POST" action="/checkout">
            <div class="row g-5">
                <!-- Receiver Info -->
                <div class="col-md-7">
                    <h4 class="fw-bold mb-4">Delivery Information</h4>
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="receiverName" class="form-control" value="<%= locals.user?.fullName ?? '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="text" name="receiverPhone" class="form-control" value="<%= locals.user?.phone ?? '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Delivery Address</label>
                        <input type="text" name="receiverAddress" class="form-control" value="<%= locals.user?.address ?? '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Method</label>
                        <select name="paymentMethod" class="form-select">
                            <option value="COD">Cash on Delivery (COD)</option>
                            <option value="BANK_TRANSFER">Bank Transfer</option>
                        </select>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="col-md-5">
                    <h4 class="fw-bold mb-4">Order Summary</h4>
                    <div class="border rounded p-4">
                        <% cart.details.forEach(d => { %>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-truncate me-2" style="max-width:180px;"><%= d.product.name %> × <%= d.quantity %></span>
                            <span>$<%= (Number(d.price) * d.quantity).toLocaleString() %></span>
                        </div>
                        <% }) %>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span class="text-primary">$<%= totalPrice.toLocaleString() %></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill mt-4">Place Order</button>
                        <a href="/cart" class="btn btn-outline-secondary w-100 rounded-pill mt-2">Back to Cart</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- Checkout End -->

<%- include('./partials/footer') %>
