<%- include('./partials/head', { title: title }) %>

<%- include('./partials/navbar') %>

<!-- Page Header -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Shop</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/shop">Home</a></li>
        <li class="breadcrumb-item active text-white">Shop</li>
    </ol>
</div>

<!-- Shop Start -->
<div class="container-fluid fruite py-5">
    <div class="container py-5">
        <h1 class="mb-4">Laptop Shop</h1>
        <%
          const shopQs = [
            search          ? 'search='   + encodeURIComponent(search)          : '',
            selectedTarget  ? 'target='   + encodeURIComponent(selectedTarget)  : '',
            selectedFactory ? 'factory='  + encodeURIComponent(selectedFactory) : '',
            sort            ? 'sort='     + encodeURIComponent(sort)            : '',
            minPrice !== '' ? 'minPrice=' + minPrice                            : '',
            maxPrice !== '' ? 'maxPrice=' + maxPrice                            : '',
          ].filter(Boolean).join('&');
        %>
        <div class="row g-4">
            <div class="col-lg-12">
                <!-- Search + Sort bar -->
                <div class="row g-3 mb-3 align-items-center">
                    <div class="col-xl-5">
                        <form method="GET" action="/" class="input-group">
                            <% if (selectedTarget)  { %><input type="hidden" name="target"   value="<%= selectedTarget %>"><% } %>
                            <% if (selectedFactory) { %><input type="hidden" name="factory"  value="<%= selectedFactory %>"><% } %>
                            <% if (sort)            { %><input type="hidden" name="sort"     value="<%= sort %>"><% } %>
                            <% if (minPrice !== '') { %><input type="hidden" name="minPrice" value="<%= minPrice %>"><% } %>
                            <% if (maxPrice !== '') { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"><% } %>
                            <input type="search" name="search" class="form-control p-3" placeholder="Search laptops..." value="<%= search %>">
                            <button class="input-group-text p-3" type="submit"><i class="fa fa-search"></i></button>
                        </form>
                    </div>
                    <div class="col-xl-3">
                        <form method="GET" action="/" class="d-flex align-items-center gap-2">
                            <% if (search)          { %><input type="hidden" name="search"   value="<%= search %>"><% } %>
                            <% if (selectedTarget)  { %><input type="hidden" name="target"   value="<%= selectedTarget %>"><% } %>
                            <% if (selectedFactory) { %><input type="hidden" name="factory"  value="<%= selectedFactory %>"><% } %>
                            <% if (minPrice !== '') { %><input type="hidden" name="minPrice" value="<%= minPrice %>"><% } %>
                            <% if (maxPrice !== '') { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"><% } %>
                            <label class="text-nowrap mb-0 text-muted small">Sort by:</label>
                            <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value=""           <%= sort === ''           ? 'selected' : '' %>>Default</option>
                                <option value="price-asc"  <%= sort === 'price-asc'  ? 'selected' : '' %>>Price: Low → High</option>
                                <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price: High → Low</option>
                                <option value="name-asc"   <%= sort === 'name-asc'   ? 'selected' : '' %>>Name: A → Z</option>
                                <option value="name-desc"  <%= sort === 'name-desc'  ? 'selected' : '' %>>Name: Z → A</option>
                            </select>
                        </form>
                    </div>
                    <% if (shopQs) { %>
                    <div class="col-auto">
                        <a href="/" class="btn btn-sm btn-outline-secondary rounded-pill">Clear filters</a>
                    </div>
                    <% } %>
                </div>

                <div class="row g-4">
                    <!-- Sidebar -->
                    <div class="col-lg-3">
                        <!-- Categories -->
                        <div class="mb-4">
                            <h4>Categories</h4>
                            <ul class="list-unstyled fruite-categorie">
                                <li>
                                    <div class="d-flex fruite-name">
                                        <a href="/<%= search || selectedFactory || sort || minPrice !== '' || maxPrice !== '' ? '?' + [search ? 'search='+encodeURIComponent(search) : '', selectedFactory ? 'factory='+encodeURIComponent(selectedFactory) : '', sort ? 'sort='+encodeURIComponent(sort) : '', minPrice !== '' ? 'minPrice='+minPrice : '', maxPrice !== '' ? 'maxPrice='+maxPrice : ''].filter(Boolean).join('&') : '' %>"
                                           class="<%= !selectedTarget ? 'fw-bold text-primary' : '' %>">
                                            <i class="fas fa-laptop me-2"></i>All Categories
                                        </a>
                                    </div>
                                </li>
                                <% targets.forEach(t => { %>
                                <li>
                                    <div class="d-flex fruite-name">
                                        <a href="/?target=<%= encodeURIComponent(t) %><%= search ? '&search='+encodeURIComponent(search) : '' %><%= selectedFactory ? '&factory='+encodeURIComponent(selectedFactory) : '' %><%= sort ? '&sort='+encodeURIComponent(sort) : '' %><%= minPrice !== '' ? '&minPrice='+minPrice : '' %><%= maxPrice !== '' ? '&maxPrice='+maxPrice : '' %>"
                                           class="<%= selectedTarget === t ? 'fw-bold text-primary' : '' %>">
                                            <i class="fas fa-laptop me-2"></i><%= t %>
                                        </a>
                                    </div>
                                </li>
                                <% }) %>
                            </ul>
                        </div>

                        <!-- Brands -->
                        <div class="mb-4">
                            <h4>Brands</h4>
                            <ul class="list-unstyled fruite-categorie">
                                <li>
                                    <div class="d-flex fruite-name">
                                        <a href="/<%= search || selectedTarget || sort || minPrice !== '' || maxPrice !== '' ? '?' + [search ? 'search='+encodeURIComponent(search) : '', selectedTarget ? 'target='+encodeURIComponent(selectedTarget) : '', sort ? 'sort='+encodeURIComponent(sort) : '', minPrice !== '' ? 'minPrice='+minPrice : '', maxPrice !== '' ? 'maxPrice='+maxPrice : ''].filter(Boolean).join('&') : '' %>"
                                           class="<%= !selectedFactory ? 'fw-bold text-primary' : '' %>">
                                            <i class="fas fa-tag me-2"></i>All Brands
                                        </a>
                                    </div>
                                </li>
                                <% factories.forEach(f => { %>
                                <li>
                                    <div class="d-flex fruite-name">
                                        <a href="/?factory=<%= encodeURIComponent(f) %><%= search ? '&search='+encodeURIComponent(search) : '' %><%= selectedTarget ? '&target='+encodeURIComponent(selectedTarget) : '' %><%= sort ? '&sort='+encodeURIComponent(sort) : '' %><%= minPrice !== '' ? '&minPrice='+minPrice : '' %><%= maxPrice !== '' ? '&maxPrice='+maxPrice : '' %>"
                                           class="<%= selectedFactory === f ? 'fw-bold text-primary' : '' %>">
                                            <i class="fas fa-tag me-2"></i><%= f %>
                                        </a>
                                    </div>
                                </li>
                                <% }) %>
                            </ul>
                        </div>

                        <!-- Price Range -->
                        <div class="mb-4">
                            <h4>Price Range</h4>
                            <form method="GET" action="/">
                                <% if (search)          { %><input type="hidden" name="search"  value="<%= search %>"><% } %>
                                <% if (selectedTarget)  { %><input type="hidden" name="target"  value="<%= selectedTarget %>"><% } %>
                                <% if (selectedFactory) { %><input type="hidden" name="factory" value="<%= selectedFactory %>"><% } %>
                                <% if (sort)            { %><input type="hidden" name="sort"    value="<%= sort %>"><% } %>
                                <div class="d-flex gap-2 mb-2">
                                    <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Min $" value="<%= minPrice %>" min="0">
                                    <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Max $" value="<%= maxPrice %>" min="0">
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary w-100 rounded-pill">Apply</button>
                            </form>
                        </div>
                    </div>

                    <!-- Product Grid -->
                    <div class="col-lg-9">
                        <div class="row g-4 justify-content-center">
                            <% if (products.length === 0) { %>
                            <div class="col-12 text-center py-5">
                                <i class="fas fa-laptop fa-4x text-secondary mb-3"></i>
                                <h4 class="text-muted">No products found.</h4>
                                <a href="/" class="btn btn-primary rounded-pill mt-3">Clear filters</a>
                            </div>
                            <% } %>
                            <% products.forEach(p => { %>
                            <div class="col-md-6 col-lg-6 col-xl-4">
                                <div class="rounded position-relative fruite-item">
                                    <div class="fruite-img">
                                        <% if (p.image) { %>
                                        <img src="<%= p.image %>" class="img-fluid w-100 rounded-top" alt="<%= p.name %>" style="height:200px;object-fit:cover;">
                                        <% } else { %>
                                        <div class="bg-light d-flex align-items-center justify-content-center rounded-top" style="height:200px;">
                                            <i class="fas fa-laptop fa-4x text-secondary"></i>
                                        </div>
                                        <% } %>
                                    </div>
                                    <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top:10px;left:10px;"><%= p.target %></div>
                                    <div class="p-4 border border-secondary border-top-0 rounded-bottom">
                                        <h4><%= p.name %></h4>
                                        <p class="text-truncate"><%= p.shortDesc %></p>
                                        <div class="d-flex justify-content-between flex-lg-wrap">
                                            <p class="text-dark fs-5 fw-bold mb-0">$<%= Number(p.price).toLocaleString() %></p>
                                            <a href="/shop/<%= p.id %>" class="btn border border-secondary rounded-pill px-3 text-primary">
                                                <i class="fa fa-eye me-2 text-primary"></i> View Detail
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                        <div class="col-12 mt-4 text-center">
                            <div class="pagination">
                                <% if (page > 1) { %>
                                <a href="/?<%= shopQs ? shopQs + '&' : '' %>page=<%= page - 1 %>"><i class="fa fa-angle-left"></i></a>
                                <% } %>
                                <% for (let i = 1; i <= totalPages; i++) { %>
                                <a href="/?<%= shopQs ? shopQs + '&' : '' %>page=<%= i %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a>
                                <% } %>
                                <% if (page < totalPages) { %>
                                <a href="/?<%= shopQs ? shopQs + '&' : '' %>page=<%= page + 1 %>"><i class="fa fa-angle-right"></i></a>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Shop End -->

<%- include('./partials/footer') %>
