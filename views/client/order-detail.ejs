<%- include('./partials/head', { title: title }) %>

<%- include('./partials/navbar') %>

<!-- Page Header -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Order #<%= order.id %></h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/orders">My Orders</a></li>
        <li class="breadcrumb-item active text-white">#<%= order.id %></li>
    </ol>
</div>

<!-- Order Detail Start -->
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row g-4">
            <!-- Order Info -->
            <div class="col-md-5">
                <div class="border rounded p-4 mb-4">
                    <h5 class="fw-bold mb-3">Delivery Details</h5>
                    <p class="mb-1"><i class="fas fa-user me-2 text-primary"></i><strong><%= order.receiverName %></strong></p>
                    <p class="mb-1"><i class="fas fa-phone me-2 text-primary"></i><%= order.receiverPhone %></p>
                    <p class="mb-0"><i class="fas fa-map-marker-alt me-2 text-primary"></i><%= order.receiverAddress %></p>
                </div>
                <div class="border rounded p-4">
                    <h5 class="fw-bold mb-3">Payment</h5>
                    <p class="mb-1">Method: <strong><%= order.paymentMethod %></strong></p>
                    <p class="mb-1">Payment Status: <strong><%= order.paymentStatus %></strong></p>
                    <p class="mb-0">Order Status:
                        <span class="badge <%= order.status === 'COMPLETE' ? 'bg-success' : order.status === 'CANCELED' ? 'bg-danger' : 'bg-warning text-dark' %>">
                            <%= order.status %>
                        </span>
                    </p>
                </div>
            </div>

            <!-- Items -->
            <div class="col-md-7">
                <h5 class="fw-bold mb-3">Items</h5>
                <div class="table-responsive">
                    <table class="table">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Unit Price</th>
                                <th>Qty</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach(item => { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <% if (item.product.image) { %>
                                        <img src="<%= item.product.image %>" style="width:50px;height:50px;object-fit:cover;" class="rounded me-2">
                                        <% } %>
                                        <span><%= item.product.name %></span>
                                    </div>
                                </td>
                                <td>$<%= Number(item.unitPrice).toLocaleString() %></td>
                                <td><%= item.quantity %></td>
                                <td>$<%= (Number(item.unitPrice) * item.quantity).toLocaleString() %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total</td>
                                <td class="fw-bold text-primary">$<%= Number(order.totalPrice).toLocaleString() %></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="mt-3">
                    <a href="/orders" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa fa-arrow-left me-2"></i> Back to Orders
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Order Detail End -->

<%- include('./partials/footer') %>
