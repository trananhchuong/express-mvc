<%- include('../partials/head', { title: title }) %>
    <body class="sb-nav-fixed">
        <%- include('../partials/topnav') %>
        <div id="layoutSidenav">
            <div id="layoutSidenav_nav">
                <%- include('../partials/sidebar') %>
            </div>
            <div id="layoutSidenav_content">
                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Products</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active">Products</li>
                        </ol>
                        <div class="card mb-4">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span><i class="fas fa-laptop me-1"></i> Product List</span>
                                <div class="d-flex gap-2 align-items-center">
                                    <form method="GET" action="/admin/products" class="d-flex gap-2">
                                        <input type="search" name="search" class="form-control form-control-sm" placeholder="Search products..." value="<%= search %>" style="width:200px;">
                                        <button class="btn btn-sm btn-outline-secondary">Search</button>
                                    </form>
                                    <a href="/admin/products/create" class="btn btn-primary btn-sm">+ Add Product</a>
                                </div>
                            </div>
                            <div class="card-body">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Image</th>
                                            <th>Name</th>
                                            <th>Factory</th>
                                            <th>Target</th>
                                            <th>Price</th>
                                            <th>Qty</th>
                                            <th>Sold</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% products.forEach(p => { %>
                                        <tr>
                                            <td><%= p.id %></td>
                                            <td>
                                                <% if (p.image) { %>
                                                    <img src="<%= p.image %>" alt="<%= p.name %>" width="50" height="40" class="object-fit-cover rounded">
                                                <% } else { %>
                                                    <i class="fas fa-image fa-2x text-secondary"></i>
                                                <% } %>
                                            </td>
                                            <td><%= p.name %></td>
                                            <td><%= p.factory %></td>
                                            <td><%= p.target %></td>
                                            <td>$<%= Number(p.price).toLocaleString() %></td>
                                            <td><%= p.quantity %></td>
                                            <td><%= p.sold %></td>
                                            <td>
                                                <a href="/admin/products/<%= p.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                                                <form method="POST" action="/admin/products/<%= p.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this product?')">
                                                    <button class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                        <% if (products.length === 0) { %>
                                        <tr><td colspan="9" class="text-center text-muted">No products found.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                                <%- include('../partials/pagination', { page, totalPages, baseUrl: '/admin/products', qs: search ? 'search=' + encodeURIComponent(search) : '' }) %>
                            </div>
                        </div>
                    </div>
                </main>
                <%- include('../partials/footer') %>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/scripts.js"></script>
    </body>
</html>
